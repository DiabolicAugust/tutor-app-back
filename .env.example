# Copy to .env and fill in. Validated at boot by src/config/env.ts — a bad value
# stops the process instead of failing on the first request.

NODE_ENV=development
PORT=3000

# Any Postgres. For a throwaway local one:
#   docker run --name fox-db -e POSTGRES_PASSWORD=fox -p 5432:5432 -d postgres:17
DATABASE_URL="postgresql://postgres:fox@localhost:5432/foxacademy?schema=public"

# A throwaway database used only to check migrations, wired up in
# `prisma.config.ts`. `prisma migrate diff --from-migrations` replays the whole
# migrations folder into it and compares the result against the schema — which is
# how every hand-authored migration here is verified, and the subjects one had a
# data backfill that only that check could prove still expressed the schema.
#
# Not needed to run the app. Needed to change it.
#   docker exec fox-db psql -U postgres -c "CREATE DATABASE fox_shadow"
SHADOW_DATABASE_URL="postgresql://postgres:fox@localhost:5432/fox_shadow?schema=public"

# At least 32 characters. Generate one: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=7d

# Origins a browser may call this API from, comma-separated.
#
# Unset means "*" in development and "nothing" in production, which is correct
# while the only client is the mobile app — native requests are not subject to
# CORS at all. An explicit "*" in production stops the boot.
CORS_ORIGINS=*

# --- Email ---------------------------------------------------------------------
#
# `log` writes messages, invitation link included, to the server log and sends
# nothing. `resend` sends for real and then RESEND_API_KEY and MAIL_FROM are
# required — the server refuses to start without them rather than claiming to
# send and quietly not.
#
# MAIL_FROM has to be an address at a domain verified with the provider. DKIM and
# SPF are DNS records on a domain you own, so this cannot be an address at
# somebody else's — which is the one thing here that a free plan does not give
# you.
MAIL_TRANSPORT=log
# RESEND_API_KEY=re_...
# MAIL_FROM=Fox Academy <invites@your-domain>

# Base for the invitation link that gets sent, by email and by the admin's own
# share sheet.
#
# In production set this to https://<this host>/invite — a page this server
# serves whose only job is to hand off to the app. That is what survives being
# pasted into a chat: a custom scheme is not a web address, so a messenger has no
# reason to make it tappable. Left as the scheme here, which is the right thing
# on a machine with no public host.
INVITE_URL_BASE=foxacademy://invite
# What that page hands off to. Two links, not one: this is where the sent one
# leads, and folding them together would have the page linking to itself.
APP_SCHEME_URL_BASE=foxacademy://invite
INVITE_TTL_HOURS=72

# --- Where uploaded files go ---------------------------------------------------
#
# "local" writes to UPLOADS_DIR, which is what a single server wants and what the
# tests use. "s3" is any S3-compatible bucket.
#
# Use "s3" on any host with an ephemeral filesystem — most PaaS free tiers,
# Render's included. On those, files written to disk disappear on every redeploy
# while their database rows stay behind, and nothing reports an error.
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads

# Required when STORAGE_DRIVER=s3; the server refuses to boot without them.
# Cloudflare R2 is a good default — no charge for egress.
#   S3_BUCKET=foxacademy-uploads
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_ACCESS_KEY_ID=
#   S3_SECRET_ACCESS_KEY=

# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=10

# How much one school may store in total, across student documents and personal
# libraries. The per-file limit bounds a single request; this bounds the account,
# so an ordinary signed-in user cannot fill the disk one allowed file at a time.
MAX_SCHOOL_STORAGE_MB=2048

# --- Push notifications -------------------------------------------------------
# "log" writes them to the server log instead of sending, which is what makes the
# whole path testable with no Firebase project and no device.
#
# "fcm" talks to Firebase Cloud Messaging directly. Not through Expo's push
# service: the app registers its native FCM token, so that hop would add an
# account, a second copy of these credentials and somebody else's rate limits for
# no translation.
PUSH_TRANSPORT=log

# Required when PUSH_TRANSPORT=fcm. The whole service-account key, as one line:
#   Firebase Console → Project settings → Service accounts → Generate new private
#   key. The project id is read from it, so there is no second variable.
#
# Newlines inside the private key may be escaped as backslash-n — the server
# accepts either, because most hosts cannot hold a real newline in an
# environment variable.
#   FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}

# --- Online lessons -----------------------------------------------------------
# Zoom and Google will not create a meeting for somebody who has not authorised
# it, so a tutor connects their own account once and the server keeps a refresh
# token. Nothing below is required: with none of it set, tutors can still choose
# Jitsi (which needs no account) or paste their own permanent meeting room.
#
# This server's own public base URL. The redirect registered with each provider
# has to match exactly:
#   <PUBLIC_API_URL>/api/meetings/callback/ZOOM
#   <PUBLIC_API_URL>/api/meetings/callback/GOOGLE_MEET
# Configured rather than derived from the request, because a redirect built from a
# Host header is spoofable and, behind a proxy, usually wrong.
#   PUBLIC_API_URL=https://tutor-app-back.onrender.com

# Where the browser is sent once a provider has approved. The app's own scheme, so
# the tab closes back into Settings.
MEETING_CONNECTED_URL=foxacademy://settings

# Encrypts the stored refresh tokens. Generate once and keep it: changing it makes
# every existing connection unreadable, and tutors have to reconnect.
#   openssl rand -base64 48
#   MEETING_TOKEN_SECRET=...

# Zoom: an OAuth app (User-managed) at marketplace.zoom.us. Scope
# "meeting:write:meeting" — the narrowest that can create a meeting.
#   ZOOM_CLIENT_ID=
#   ZOOM_CLIENT_SECRET=

# Google: a Web application OAuth client in the Cloud console, with the Google
# Meet API enabled and the scope
# ".../auth/meetings.space.created" on the consent screen. A *Web* client rather
# than an Android one, because the code is exchanged by this server, which is the
# only place a client secret belongs.
#   GOOGLE_CLIENT_ID=
#   GOOGLE_CLIENT_SECRET=
#
# Once a tutor has connected in the app, prove it against the real provider:
#   npm run meetings:preflight -- tutor@example.com ZOOM
