// Domain model for the Fox Academy backend.
//
// Mirrors the shapes the mobile app already renders (see its `src/shared`
// folders): a tutor's calendar of lessons, the students those lessons are for,
// and the notifications that fall out of both. Where the app currently holds
// fixtures, this is the thing that will replace them — so field names are kept
// deliberately identical to the app's types.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  // The rest of this project compiles to CommonJS, and the generator defaults to
  // ESM: without this the emitted client carries `import.meta`, which makes Node
  // treat the compiled file as a module and fail on `exports is not defined`
  // before the server finishes starting.
  moduleFormat        = "cjs"
  // Extensionless relative imports, because the emitted client is CommonJS: the
  // default `.js` suffixes are an ESM requirement that only TypeScript's own
  // resolver understands, and every other tool reading these files — Jest's
  // resolver among them — looks for a `.js` that was never emitted.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// A tutoring business. Every other row belongs to exactly one, so tenant
/// isolation is a single `where` clause rather than a convention.
model School {
  id            String   @id @default(cuid())
  name          String
  /// Human-readable identifier for invite links and, later, subdomains. A cuid
  /// is fine for a foreign key and useless in a URL somebody has to type.
  slug          String   @unique
  /// IANA zone the school schedules in. Lesson times are meaningless without
  /// one as soon as there is a second school in another country.
  timezone      String   @default("UTC")
  /// Top of the school's classic grading scale — 12 in Ukraine, 6 in Poland,
  /// 5 in much of the region. A setting rather than a constant because a grade
  /// of 5 means "excellent" or "mediocre" depending on it, and an average is
  /// unreadable without knowing which.
  gradeScaleMax Int      @default(12)
  /// Independent tutors get a school of their own; the app shows no difference.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users       User[]
  students    Student[]
  groups      Group[]
  subjects    Subject[]
  lessons     Lesson[]
  files       File[]
  invitations Invitation[]

  /// Optional branding, shown in the app's header for school accounts.
  logoFileId String?
  logo       File?   @relation("SchoolLogo", fields: [logoFileId], references: [id], onDelete: SetNull)

  @@map("schools")
}

/// Two roles, because there are two jobs: a tutor teaches, an admin runs the
/// school. Students are records owned by a tutor, not accounts that sign in, so
/// they are deliberately not a role.
enum UserRole {
  TUTOR
  ADMIN
}

/// An identity that can sign in. Matches the app's `AuthUser`.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// Argon/bcrypt hash. Never leaves the auth module.
  passwordHash String
  name         String
  role         UserRole @default(TUTOR)
  /// Bumped to end every session the account holds.
  ///
  /// What makes signing out mean something. A JWT is valid until it expires
  /// because nothing consults a database to check it — that is the point of one —
  /// so revoking needs a value on this side to compare against. Each token
  /// carries the version it was issued under, and the strategy refuses any token
  /// whose version is not the current one.
  ///
  /// A counter rather than a timestamp, and that is the whole design. `iat` has
  /// one-second resolution, so a revocation instant either lets a token issued
  /// in the same second survive or refuses the session the user just created —
  /// with no way to tell those two apart. A counter has no such ambiguity: the
  /// token issued after the bump carries the new number, every token issued
  /// before it carries an older one, and nothing depends on a clock.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// Lessons this user teaches — the "whose calendar" axis in the app.
  lessonsTaught   Lesson[]       @relation("LessonTutor")
  /// Groups this user runs.
  groupsTaught    Group[]        @relation("GroupTutor")
  /// Students this user teaches.
  students        Student[]      @relation("StudentTutor")
  notifications   Notification[]
  uploadedFiles   File[]         @relation("FileUploader")
  sentInvitations Invitation[]   @relation("InvitationSender")
  addons          UserAddon[]    @relation("UserAddons")
  addonsGranted   UserAddon[]    @relation("AddonGranter")

  avatarFileId String?
  avatar       File?   @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)

  /// Per-user preferences — notification timing and anything similar that
  /// follows the account rather than the device.
  ///
  /// A column on the user rather than a table: it is always read with the user,
  /// never queried on its own, and a table would mean a join on every session.
  /// Untyped here and validated in `users/user-config.ts`, so adding a
  /// preference needs no migration.
  config Json @default("{}")

  supportRequests SupportRequest[] @relation("SupportRequester")
  notesWritten    Note[]           @relation("NoteAuthor")
  gradesGiven     Grade[]          @relation("GradeAuthor")
  devices         PushToken[]      @relation("UserDevices")

  @@index([schoolId])
  @@map("users")
}

/// Something a school teaches.
///
/// A row rather than a word typed onto every student, group and lesson. As a
/// string the same subject arrived spelled three ways, which made "how many
/// maths lessons this month" unanswerable and every picker a free-text field
/// with no right answer in it.
///
/// Scoped to a school and only to a school: one school's list must never appear
/// in another's pickers, which is why this is not a shared table of subject
/// names.
model Subject {
  id        String    @id @default(cuid())
  name      String
  /// When it stopped being taught. Null means it is on offer now.
  ///
  /// Hidden rather than deleted, because a lesson taught last term still has to
  /// be able to say what it was about. Deleting the row would either take that
  /// history with it or leave it pointing at nothing; hiding it takes the
  /// subject out of every picker and leaves every record that already names it
  /// exactly as it was.
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  students Student[]
  groups   Group[]
  lessons  Lesson[]

  /// One school cannot have the same subject twice — that duplication is what
  /// this model exists to end.
  ///
  /// Hidden rows are included on purpose. A hidden "Algebra" next to a new one
  /// would be two subjects with one name and the history split between them, so
  /// adding a name that is already hidden offers to bring it back instead.
  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("subjects")
}

/// Someone being taught. An entity rather than a name on a lesson, because they
/// have a balance and a history.
model Student {
  id              String   @id @default(cuid())
  name            String
  /// Lessons remaining on the current package. Drives payment reminders.
  paidLessonsLeft Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// The tutor who teaches them; the app books only for its own students.
  tutorId String
  tutor   User   @relation("StudentTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  /// What they usually study; prefills the subject when booking.
  ///
  /// Optional, as it was when this was a string: a student can be on the books
  /// before anybody has settled what they are studying.
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  lessons     Lesson[]
  notes       Note[]
  grades      Grade[]
  /// Groups this student is in. A student can be in several: a teenager doing
  /// both a conversation group and exam prep is the ordinary case.
  groups      GroupMember[]
  attendances LessonAttendance[]
  /// Documents kept against the student — a contract, a report, a worksheet.
  files       File[]

  @@index([schoolId])
  @@index([tutorId])
  @@index([subjectId])
  @@map("students")
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// Whether the student turned up — and if not, whose fault it was.
///
/// The excused/unexcused split is not bookkeeping pedantry: it is the whole
/// commercial difference between a lesson somebody cancelled in time and a
/// no-show. One is refunded, the other is charged, and a single `ABSENT` value
/// would make the schedule unable to say which.
///
/// Null on a lesson means nobody has marked it yet, which is why it is optional
/// rather than carrying a `NOT_MARKED` value: "unknown" is the absence of an
/// answer, not one of the answers.
enum AttendanceStatus {
  PRESENT
  /// Turned up, but late. Present for billing, distinct for the record.
  LATE
  /// Cancelled in time, or a reason the school accepts. Not charged.
  ABSENT_EXCUSED
  /// A no-show. Charged, because the slot was held.
  ABSENT_UNEXCUSED
}

/// How a mark is expressed.
///
/// Three kinds rather than one number, because schools genuinely grade in three
/// different registers and forcing one on them is what makes a gradebook go
/// unused: a scale mark for a test, a percentage for a quiz, and words for
/// everything that does not reduce to a number.
enum GradeKind {
  /// A point on the school's scale — see `School.gradeScaleMax`.
  CLASSIC
  /// 0–100.
  PERCENTAGE
  /// Words only. Carries no value, and is deliberately left out of averages.
  DESCRIPTIVE
}

model Lesson {
  id              String       @id @default(cuid())
  startsAt        DateTime
  durationMinutes Int
  status          LessonStatus @default(SCHEDULED)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  tutorId String
  tutor   User   @relation("LessonTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  /// What is being taught.
  ///
  /// Nullable, and deliberately: the app has always accepted a lesson with no
  /// subject typed in and shown it as just "Lesson". A required column would
  /// have meant inventing a subject for every such lesson already recorded.
  /// New lessons are required to name one — that rule belongs in the DTO, where
  /// it can be enforced without rewriting history to satisfy it.
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  /// The student, for a one-to-one lesson. Null for a group lesson.
  ///
  /// **Exactly one of `studentId` and `groupId` is set.** Prisma cannot express
  /// that, so `LessonsService` enforces it — the same arrangement `Note` uses for
  /// the same reason: two near-identical tables for one idea would mean two of
  /// everything above them, and they would drift.
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// The group, for a group lesson. Null for a one-to-one lesson.
  ///
  /// The group rather than a list of students, because membership changes and the
  /// lesson should follow it: adding somebody to a group on Tuesday must put them
  /// in Wednesday's lesson without anybody editing the lesson.
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  /// What was actually covered. Null until the lesson has been taught, which is
  /// also what makes "which lessons still need writing up" a query.
  ///
  /// Lesson-level, unlike attendance: the topic is the same for everybody in the
  /// room, and so is the homework that was set.
  topic    String?
  /// What was set for next time. Whether each student *did* it is per-student —
  /// see `LessonAttendance.homeworkDone`.
  homework String?

  notes       Note[]
  grades      Grade[]
  attendances LessonAttendance[]

  /// Range queries by calendar owner are the calendar's only read pattern.
  @@index([tutorId, startsAt])
  @@index([schoolId, startsAt])
  @@index([groupId, startsAt])
  /// Answers "what still teaches this" before a subject is hidden.
  @@index([subjectId])
  @@map("lessons")
}

/// A set of students taught together.
///
/// The container a group lesson hangs off, rather than a list of students on the
/// lesson itself: membership changes, and the schedule has to follow it. Adding
/// somebody to a group on Tuesday must put them in Wednesday's lesson without
/// anybody editing the lesson.
model Group {
  id        String   @id @default(cuid())
  name      String
  /// Free text — "B1", "Beginners", "Year 9". Every school names levels its own
  /// way, so a closed list would be wrong for all of them.
  level     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// The tutor who runs it. Same rule as a student: a tutor sees their own, an
  /// admin sees the school's.
  tutorId String
  tutor   User   @relation("GroupTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  /// What the group studies; prefills the subject when booking for it.
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  members GroupMember[]
  lessons Lesson[]

  @@index([schoolId])
  @@index([tutorId])
  @@index([subjectId])
  @@map("groups")
}

/// One student's place in one group.
///
/// A row rather than an array column, so it carries a date and can be queried
/// from either side — "who is in this group" and "which groups is this student
/// in" are both real questions.
///
/// Deliberately no `leftAt`. Removing somebody deletes this row and nothing else:
/// their attendance and marks reference the lesson and the student directly, so
/// the history stays intact without a second concept of membership-over-time to
/// keep consistent.
model GroupMember {
  id       String   @id @default(cuid())
  joinedAt DateTime @default(now())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Nobody is in a group twice.
  @@unique([groupId, studentId])
  @@index([studentId])
  @@map("group_members")
}

/// Whether one student turned up to one lesson.
///
/// A row per student per lesson, which is the only shape that works for both
/// kinds of lesson: a one-to-one lesson gets exactly one row, a group lesson one
/// per member. The alternative — a column on the lesson for the individual case
/// and a table for the group case — would be two mechanisms for one idea, and
/// every feature above them would have to pick one and could pick wrong.
///
/// Absence of a row means nobody has marked this student yet. That is why there
/// is no `NOT_MARKED` status: "unknown" is the absence of an answer, not one of
/// the answers.
///
/// No `schoolId`, like `Note` and `Grade`: every read and write goes through the
/// lesson, whose ownership has already been proven.
model LessonAttendance {
  id           String           @id @default(cuid())
  status       AttendanceStatus
  /// Whether this student's homework came back done.
  ///
  /// Per-student while the homework *text* is per-lesson, because that is how it
  /// actually works: one assignment is set for the room, and each person either
  /// did it or did not. Three states, so nullable — nobody has checked, checked
  /// and done, checked and not done.
  homeworkDone Boolean?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// One answer per student per lesson; marking again updates it.
  @@unique([lessonId, studentId])
  @@index([studentId])
  @@map("lesson_attendances")
}

/// Something a tutor wrote down — about a student in general, or about one
/// lesson in particular.
///
/// **Exactly one of `studentId` and `lessonId` is set.** Prisma cannot express
/// that, so `NotesService` enforces it; the alternative — two near-identical
/// tables — would mean two endpoints, two clients and two components for one
/// idea, and they would drift.
///
/// A lesson note deliberately does not also carry the student: the lesson
/// already knows whose it is, and a second copy is a second thing to keep true.
///
/// No `schoolId` either, unlike most rows here. Every read and write goes
/// through the parent student or lesson, whose ownership has already been
/// proven — a school on the note would be a second answer to "whose is this"
/// that can disagree with the first.
model Note {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Who wrote it. Shown in the app, because a school has more than one tutor.
  authorId String
  author   User   @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([lessonId, createdAt])
  @@map("notes")
}

/// A mark a tutor gave.
///
/// Always against a **student**, and optionally also against the lesson it came
/// out of. That asymmetry is deliberate: the lesson is where a mark is usually
/// entered, but the thing anybody wants to read later is the student's history,
/// and a grade whose only owner was a lesson would vanish from that history the
/// day the lesson was deleted. A grade for a term test belongs to nobody's
/// lesson at all.
///
/// No `schoolId`, for the same reason `Note` has none: every read and write goes
/// through the student, whose ownership has already been proven, and a second
/// answer to "whose is this" is a second thing that can be wrong.
model Grade {
  id        String    @id @default(cuid())
  kind      GradeKind
  /// The number, for `CLASSIC` and `PERCENTAGE`. Null for `DESCRIPTIVE`.
  ///
  /// A float rather than an int because half-marks are real ("4.5") and a
  /// percentage of 87.5 is not a rounding error. The range is validated against
  /// the school's scale in the service, not here — the database cannot see which
  /// school this belongs to without a join.
  value     Float?
  /// What it was for: "speaking", "homework", "unit 3 test". Free text rather
  /// than an enum, because every school names these differently and a closed
  /// list would be wrong for all of them.
  category  String?
  /// The words. The entire mark for `DESCRIPTIVE`, an optional remark otherwise.
  comment   String?
  /// How much it counts in the average. A term test is not a vocabulary quiz.
  weight    Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// The lesson it was given in, when it was given in one. `SetNull` rather than
  /// `Cascade`: deleting a lesson must not silently delete a student's marks.
  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  /// Who gave it. Shown in the app, and the only person besides an admin who may
  /// change it.
  authorId String
  author   User   @relation("GradeAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  /// The student's gradebook, newest first — the one read that matters.
  @@index([studentId, createdAt])
  @@index([lessonId])
  @@map("grades")
}

/// Which store's push service a token belongs to.
enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

/// A device that can receive push notifications.
///
/// One row per **device**, not per user, and `token` is unique because of what
/// that implies: a phone can be handed to somebody else, or the same person can
/// sign out and sign in as a colleague. Registering a token that already exists
/// therefore reassigns it rather than adding a second row — otherwise an
/// announcement would keep arriving for whoever used the device first.
///
/// `lastSeenAt` is what makes stale rows findable. A token stays valid until the
/// push service says otherwise, and reinstalling an app issues a new one without
/// retiring the old, so without this the table only grows.
model PushToken {
  id         String         @id @default(cuid())
  token      String         @unique
  platform   DevicePlatform
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime       @default(now())

  userId String
  user   User   @relation("UserDevices", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

/// Kinds a server actually sends. The app derives lesson reminders itself from
/// the schedule, so those are deliberately absent here.
enum NotificationKind {
  ADMIN_ANNOUNCEMENT
  TUTOR_JOINED
  PAYMENT_RUNNING_OUT
}

model Notification {
  id        String           @id @default(cuid())
  kind      NotificationKind
  /// Interpolation values for the kind's message: studentName, personName,
  /// count, text. Untyped on purpose — the app's registry owns the copy, and a
  /// column per kind would grow with every new one.
  data      Json             @default("{}")
  createdAt DateTime         @default(now())
  readAt    DateTime?

  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@map("notifications")
}

/// What an upload is for. Drives validation limits and retention, and keeps a
/// lesson attachment from being served as somebody's avatar.
enum FilePurpose {
  AVATAR
  SCHOOL_LOGO
  LESSON_ATTACHMENT
  /// A document kept against a student: a contract, a report, a worksheet.
  STUDENT_ATTACHMENT
  /// Teaching material a tutor keeps for themselves — a worksheet they reuse, a
  /// textbook scan, an exam paper. Belongs to the person, not to a student, which
  /// is what makes it reachable by its uploader rather than by the school.
  TUTOR_LIBRARY
  OTHER
}

/// One row per uploaded file, always.
///
/// Storage holds bytes and nothing else — it cannot tell you who uploaded a
/// file, which school it belongs to, or whether it is still referenced. This
/// table is the record of truth; `storageKey` is the only thing the storage
/// backend knows about. Rows are created before the upload completes and
/// finalised after, so an interrupted upload leaves a row that can be cleaned
/// up rather than an orphaned object nobody knows exists.
model File {
  id           String      @id @default(cuid())
  /// Path or object key in the storage backend. Unique so two rows can never
  /// claim the same bytes.
  storageKey   String      @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  purpose      FilePurpose @default(OTHER)
  /// Null until the upload is confirmed; unconfirmed rows are collectable.
  uploadedAt   DateTime?
  createdAt    DateTime    @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  /// Set for a `STUDENT_ATTACHMENT`. Null for anything else, which is why it is
  /// optional rather than a second table.
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Back-references from the rows that point at this file, so deleting a file
  /// that is still in use is a database error rather than a broken image.
  avatarOf User[]   @relation("UserAvatar")
  logoOf   School[] @relation("SchoolLogo")

  @@index([schoolId, purpose])
  @@index([studentId])
  @@map("files")
}

/// An invitation for someone to join a school as a tutor.
///
/// Kept as a row rather than a signed stateless token so it can be revoked,
/// listed by the admin who sent it, and marked used exactly once.
model Invitation {
  id         String    @id @default(cuid())
  /// Who it was sent to. Not a foreign key: the point is that no account exists.
  email      String
  /// Random secret carried in the emailed link.
  token      String    @unique
  role       UserRole  @default(TUTOR)
  expiresAt  DateTime
  /// Set when the invitation is redeemed; a second attempt is then rejected.
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  /// One live invitation per email per school; re-inviting replaces it.
  @@unique([schoolId, email])
  @@index([schoolId, createdAt])
  @@map("invitations")
}

/// A capability that can be granted to an individual member.
///
/// Roles answer "what job does this person do"; addons answer "what is this
/// person allowed to do", which is not the same question. A school may want one
/// senior tutor who can invite colleagues without making them an admin.
///
/// A closed enum rather than free-text strings: both the API and the app switch
/// on these, and a typo in a permission is the worst kind of bug to debug.
/// Adding a capability is one value here plus one registry entry on each side
/// that implements it.
enum AddonKey {
  /// Invite tutors to the school.
  INVITE_TUTORS
  /// Send an announcement to everyone in the school.
  BROADCAST_ANNOUNCEMENTS
  /// Add, edit and remove students. A tutor may only touch their own; an admin
  /// holds every addon and so reaches the whole school.
  MANAGE_STUDENTS
}

/// A capability granted to one member.
///
/// Rows rather than a bitmask or a JSON array: a grant has an author and a date,
/// which is what makes "who gave them that?" answerable.
model UserAddon {
  id        String   @id @default(cuid())
  addon     AddonKey
  createdAt DateTime @default(now())

  userId String
  user   User   @relation("UserAddons", fields: [userId], references: [id], onDelete: Cascade)

  /// The admin who enabled it. Kept for audit; nulled if they leave.
  enabledById String?
  enabledBy   User?   @relation("AddonGranter", fields: [enabledById], references: [id], onDelete: SetNull)

  @@unique([userId, addon])
  @@index([userId])
  @@map("user_addons")
}

/// Where a support request stands. `NEW` until somebody looks at it.
enum SupportRequestStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

/// A message a user sent to support.
///
/// Stored before any attempt to deliver it. Email can fail, a provider can be
/// unconfigured, and a request that exists only in an outbound message is a
/// request that was never received — so the row is the commitment and the email
/// is a notification about it.
model SupportRequest {
  id         String               @id @default(cuid())
  message    String
  status     SupportRequestStatus @default(NEW)
  createdAt  DateTime             @default(now())
  handledAt  DateTime?
  /// Whether the notification email actually went out; null while untried.
  notifiedAt DateTime?

  userId String
  user   User   @relation("SupportRequester", fields: [userId], references: [id], onDelete: Cascade)

  /// Denormalised so support can triage by school without a join.
  schoolId String

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("support_requests")
}
